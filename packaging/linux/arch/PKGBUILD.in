# Arch Linux package of a Twinnel release (the prebuilt Linux archive).
# Generated by scripts/package-linux-app.sh from packaging/linux/arch/PKGBUILD.in.
#
#   makepkg -si      next to twinnel-bin.install (downloads the archive and checks it)
#
# Then install the helper once (a root service, outside the package):
# open Twinnel and click 安装后台助手 / Install Helper, or
#   sudo twinnel helper install --helper-bin /opt/twinnel/bin/twinnel-helper

pkgname=twinnel-bin
_ver=@VERSION@
pkgver=@PKGVER@
pkgrel=1
pkgdesc='mihomo and Tailscale, side by side on one computer'
arch=(@ARCHES@)
url='https://github.com/@REPO@'
license=('MIT')
# The app is pure Go and loads these at run time (dlopen): GTK 3 (with
# GLib, Pango, Cairo, GdkPixbuf), libepoxy and EGL for drawing, the
# AppIndicator library for the tray icon.
depends=('gtk3' 'libepoxy' 'libglvnd' 'libayatana-appindicator' 'systemd')
optdepends=(
	'polkit: install the helper from the app (pkexec)'
	'libnotify: notifications'
	'gtk-layer-shell: the tray flyout on wlroots compositors (Sway, Hyprland)'
	'gnome-shell-extension-appindicator: the tray icon on GNOME'
)
provides=('twinnel')
conflicts=('twinnel')
install=twinnel-bin.install
options=('!strip' '!debug')
source_x86_64=("https://github.com/@REPO@/releases/download/v${_ver}/Twinnel_${_ver}_linux_amd64_app.tar.gz")
source_aarch64=("https://github.com/@REPO@/releases/download/v${_ver}/Twinnel_${_ver}_linux_arm64_app.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
	local a
	case "$CARCH" in
	x86_64) a=amd64 ;;
	aarch64) a=arm64 ;;
	esac
	cd "Twinnel_${_ver}_linux_${a}_app"
	install -Dm0755 Twinnel "$pkgdir/opt/twinnel/Twinnel"
	install -Dm0755 bin/twinnel "$pkgdir/opt/twinnel/bin/twinnel"
	install -Dm0755 bin/twinnel-helper "$pkgdir/opt/twinnel/bin/twinnel-helper"
	install -Dm0644 VERSION "$pkgdir/opt/twinnel/VERSION"
	install -d "$pkgdir/usr/bin"
	ln -s /opt/twinnel/bin/twinnel "$pkgdir/usr/bin/twinnel"
	install -Dm0644 share/applications/twinnel.desktop "$pkgdir/usr/share/applications/twinnel.desktop"
	local f
	while IFS= read -r f; do
		install -Dm0644 "share/icons/$f" "$pkgdir/usr/share/icons/$f"
	done < <(cd share/icons && find hicolor -type f)
	install -Dm0644 twinnel-helper.service "$pkgdir/usr/share/doc/twinnel/twinnel-helper.service"
	install -Dm0644 INSTALL.md "$pkgdir/usr/share/doc/twinnel/INSTALL.md"
	install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
